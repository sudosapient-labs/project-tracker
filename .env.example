# Copy to .env (or set in your host's environment). Everything has a local-development default.

# Public URL people open; used in emailed links.
APP_URL=https://tracker.example.com
PORT=8787
# SQLite database and uploaded files. Keep both on persistent, backed-up storage.
DATABASE_PATH=/data/gr8r.db
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_MB=250

# Outgoing email (verification, password reset, invites, notifications, digests) via Resend.
# Without a key, emails are only logged. The MAIL_FROM domain must be verified in Resend.
RESEND_API_KEY=
MAIL_FROM=Sudo Sapient <no-reply@sudosapient.dev>

# Set when running behind a reverse proxy / load balancer that sets X-Forwarded-For.
TRUST_PROXY=false
# After the first account, people need an invite (or invite link) unless this is true.
ALLOW_OPEN_SIGNUP=false
# Only for trusted internal deployments without email.
REQUIRE_EMAIL_VERIFICATION=true

# Copy to .env (or set in your host's environment). Everything has a local-development default.

# Only `development` (what `pnpm dev` sets) and `test` relax security. Any other value, or none, runs
# with production behaviour: Secure cookies, the setup token, and no emailed links in API responses.
NODE_ENV=production

# Public URL people open; used in emailed links.
APP_URL=https://tracker.example.com
PORT=8787
# SQLite database and uploaded files. Keep both on persistent, backed-up storage.
DATABASE_PATH=/data/gr8r.db
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_MB=250

# Outgoing email (verification, password reset, invites, notifications, digests) via Resend.
# Without a key no email is sent: in production only each message's recipient and subject are
# logged (and the server warns at startup). The MAIL_FROM domain must be verified in Resend.
RESEND_API_KEY=
MAIL_FROM=Sudo Sapient <no-reply@sudosapient.dev>
# Production without RESEND_API_KEY: also log each email's link (sign-in, reset and invite links).
# Anyone who can read the logs can then use them. Leave false unless you need it.
LOG_EMAIL_LINKS=false

# Encrypts two-factor (TOTP) secrets at rest with AES-256-GCM. 32+ bytes, e.g. `openssl rand -base64 32`.
# Existing secrets are encrypted on the next start. Don't lose or change it: authenticator codes stop
# working without the same key (recovery codes still do). Unset: secrets are stored unencrypted.
SECRET_KEY=

# Web Push. Optional: without these, a key pair is generated on first start and kept in the database.
# Set them explicitly if you run more than one database or want to rotate keys.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:no-reply@sudosapient.dev

# Reverse proxies in front of the app that append to X-Forwarded-For: the number of them (`true` = 1).
# The client address is taken that many entries from the right, so clients can't spoof it.
# Leave false when the app is reached directly.
TRUST_PROXY=false
# Needed to create the first (Owner) account on a fresh deployment: open APP_URL/#setup/<token>.
# In production, when unset and there's no workspace yet, a one-off token is generated and the setup
# link is printed to the server log. In development and test, first sign-up needs no token unless set.
SETUP_TOKEN=
# After the first account, people need an invite (or invite link) unless this is true.
ALLOW_OPEN_SIGNUP=false
# Only for trusted internal deployments without email.
REQUIRE_EMAIL_VERIFICATION=true

# Backups (`pnpm db:backup` / `node server/scripts/backup.js`, and daily in the running server when
# BACKUP_DIR is set): SQLite copies named gr8r-<UTC time>.db (the newest BACKUP_KEEP are kept) plus
# BACKUP_DIR/uploads, a mirror of UPLOAD_DIR. Unset, the script writes `backups` next to the database.
# Put it on separate storage: a backup on the same volume as the data doesn't survive losing it.
BACKUP_DIR=/backups
BACKUP_KEEP=14

{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "node",
      "package-name": "sudo-sapient",
      "changelog-path": "CHANGELOG.md",
      "include-component-in-tag": false,
      "bump-minor-pre-major": true,
      "bump-patch-for-minor-pre-major": false,
      "exclude-paths": ["packages"]
    },
    "packages/client": {
      "release-type": "node",
      "component": "client",
      "include-component-in-tag": true,
      "initial-version": "0.1.0",
      "bump-minor-pre-major": true,
      "bump-patch-for-minor-pre-major": false
    },
    "packages/cli": {
      "release-type": "node",
      "component": "cli",
      "include-component-in-tag": true,
      "initial-version": "0.1.0",
      "bump-minor-pre-major": true,
      "bump-patch-for-minor-pre-major": false,
      "extra-files": ["src/cli.js"]
    },
    "packages/mcp": {
      "release-type": "node",
      "component": "mcp",
      "include-component-in-tag": true,
      "initial-version": "0.1.0",
      "bump-minor-pre-major": true,
      "bump-patch-for-minor-pre-major": false,
      "extra-files": ["src/protocol.js"]
    },
    "packages/slack-bot": {
      "release-type": "node",
      "component": "slack-bot",
      "include-component-in-tag": true,
      "initial-version": "0.1.0",
      "bump-minor-pre-major": true,
      "bump-patch-for-minor-pre-major": false
    }
  }
}

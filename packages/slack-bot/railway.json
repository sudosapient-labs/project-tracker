{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "packages/slack-bot/Dockerfile",
    "watchPatterns": ["packages/slack-bot/**", "packages/client/**", "packages/mcp/src/**", "pnpm-lock.yaml", "pnpm-workspace.yaml"]
  },
  "deploy": {
    "healthcheckPath": "/health",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
